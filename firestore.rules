rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/app/{documentId} {
      allow read: if request.auth != null && request.auth.uid == userId && documentId == 'state';
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && documentId == 'state'
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is map;
      allow delete: if request.auth != null && request.auth.uid == userId && documentId == 'state';
    }
  }
}
